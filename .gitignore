# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Environment and secrets
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*-keys.json

# Runtime databases (SQLite catalogs, license server state)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Build artifacts
*.o
*.so
*.dylib
*.dll
*.a
*.lib
*.exe

# Test and coverage
tarpaulin-report.html
lcov.info
coverage/
*.profraw
*.profdata

# Logs
*.log
logs/

# Checkpoint and transfer state (runtime data)
*.checkpoint
*.ahp-state

# Benchmarks output
criterion/

# Benchmark third-party tools (built from source)
benchmarks/UDT/
benchmarks/bbcp/

# OS files
Thumbs.db
Desktop.ini

# Python / RL training
training/venv/
training/__pycache__/
training/*.egg-info/
*.pt
*.pth
*.onnx
rl_weights.bin
rl_traces/
# Allow versioned RL weights in the repo
!crates/ahp-congestion/weights/rl_weights_v*.bin

# custom
artifacts.md

# CI loopback smoke-test scratch (created by favonius.yml)
smoke/

# Benchmark scratch (test data / receive dirs — regenerated per run)
benchmarks/src/
benchmarks/dst/

# Benchmark docker build context: vendored tool binaries plus a 128 MB
# test payload (~168 MB). Rebuilt by benchmarks/scripts/bench_netem_fair_v2.sh.
# The internal image copies prebuilt binaries from a path that does not
# ship; Dockerfile.public builds from source and is the one the published
# harness uses, so it must be tracked or `bench_netem_fair_v2.sh` dies with
# "no Dockerfile in ...".
benchmarks/docker/
!benchmarks/docker/bench-v2/
!benchmarks/docker/bench-v2/Dockerfile.public

# Generated per-target at release time by packaging/gen-attribution.py.
# Ships inside the tarball; not tracked, because it is derived from
# Cargo.lock and would rot silently if it were.
THIRD-PARTY-LICENSES.md

# Local release bundles
*.bundle

# Local tooling and working notes, not part of the project.
CLAUDE.md
